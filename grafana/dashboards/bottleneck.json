{
  "uid": "bottleneck-v1",
  "title": "Goulots d'étranglement — Simulation",
  "description": "10 indicateurs pour identifier les goulots d'étranglement de la simulation multi-agents",
  "tags": ["bottleneck", "simulation", "performance"],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "10s",
  "time": { "from": "now-1h", "to": "now" },
  "panels": [
    {
      "id": 1,
      "type": "row",
      "title": "Scheduler",
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 0 }
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "① Scheduling Lag (p50 / p95 / p99)",
      "description": "δ entre scheduled_start_time et envoi de l'action à GAMA. Valeur positive = action envoyée APRÈS l'heure prévue.",
      "datasource": { "type": "prometheus", "uid": "ffj2fwnh387pce" },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.50, sum(rate(agent_scheduling_lag_seconds_bucket[2m])) by (le))",
          "legendFormat": "p50"
        },
        {
          "refId": "B",
          "expr": "histogram_quantile(0.95, sum(rate(agent_scheduling_lag_seconds_bucket[2m])) by (le))",
          "legendFormat": "p95"
        },
        {
          "refId": "C",
          "expr": "histogram_quantile(0.99, sum(rate(agent_scheduling_lag_seconds_bucket[2m])) by (le))",
          "legendFormat": "p99"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 60 },
              { "color": "red", "value": 300 }
            ]
          }
        },
        "overrides": []
      },
      "options": { "tooltip": { "mode": "multi" } },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 1 }
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "④ Agents en attente de décision LLM",
      "description": "Nombre d'agents avec scheduling_in_progress=True. Révèle la pression instantanée sur le LLM.",
      "datasource": { "type": "prometheus", "uid": "ffj2fwnh387pce" },
      "targets": [
        {
          "refId": "A",
          "expr": "controller_scheduling_in_progress",
          "legendFormat": "en cours"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": { "mode": "palette-classic" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 50 },
              { "color": "red", "value": 100 }
            ]
          }
        },
        "overrides": []
      },
      "options": { "tooltip": { "mode": "single" } },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 1 }
    },
    {
      "id": 4,
      "type": "row",
      "title": "LLM Queue",
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 9 }
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "② Profondeur file de tâches LLM (batch:*)",
      "description": "Tâches PENDING dans Redis. Si > 50 et croissant → saturation providers.",
      "datasource": { "type": "prometheus", "uid": "ffj2fwnh387pce" },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(llm_task_queue_depth)",
          "legendFormat": "total pending"
        },
        {
          "refId": "B",
          "expr": "llm_task_queue_depth",
          "legendFormat": "{{batch_key}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 20 },
              { "color": "red", "value": 50 }
            ]
          }
        },
        "overrides": []
      },
      "options": { "tooltip": { "mode": "multi" } },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 10 }
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "③ Durée E2E tâche LLM (p50 / p95) par catégorie",
      "description": "Temps total POST /tasks → réponse finale. Décompose queue time + inference time.",
      "datasource": { "type": "prometheus", "uid": "ffj2fwnh387pce" },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.50, sum(rate(llm_task_e2e_duration_seconds_bucket[5m])) by (le, category))",
          "legendFormat": "p50 {{category}}"
        },
        {
          "refId": "B",
          "expr": "histogram_quantile(0.95, sum(rate(llm_task_e2e_duration_seconds_bucket[5m])) by (le, category))",
          "legendFormat": "p95 {{category}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 10 },
              { "color": "red", "value": 30 }
            ]
          }
        },
        "overrides": []
      },
      "options": { "tooltip": { "mode": "multi" } },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 10 }
    },
    {
      "id": 7,
      "type": "row",
      "title": "OTP & Cache",
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 18 }
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "⑤ Latence OTP p95 par instance",
      "description": "Latence p95 des appels OTP par instance. Révèle si OTP est le goulot ou si c'est le LLM.",
      "datasource": { "type": "prometheus", "uid": "ffj2fwnh387pce" },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95, sum(rate(otp_request_duration_seconds_bucket[5m])) by (le, instance))",
          "legendFormat": "p95 {{instance}}"
        },
        {
          "refId": "B",
          "expr": "histogram_quantile(0.50, sum(rate(otp_request_duration_seconds_bucket[5m])) by (le, instance))",
          "legendFormat": "p50 {{instance}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 1 },
              { "color": "red", "value": 5 }
            ]
          }
        },
        "overrides": []
      },
      "options": { "tooltip": { "mode": "multi" } },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 19 }
    },
    {
      "id": 9,
      "type": "timeseries",
      "title": "⑥ Ratio cache hit OTP (CachedTripHelper)",
      "description": "Ratio hits / total. Si < 0.3 → cache trop invalidé, beaucoup d'appels OTP inutiles.",
      "datasource": { "type": "prometheus", "uid": "ffj2fwnh387pce" },
      "targets": [
        {
          "refId": "A",
          "expr": "trip_cache_hit_ratio",
          "legendFormat": "hit ratio"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0,
          "max": 1,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": null },
              { "color": "yellow", "value": 0.3 },
              { "color": "green", "value": 0.6 }
            ]
          },
          "color": { "mode": "thresholds" }
        },
        "overrides": []
      },
      "options": { "tooltip": { "mode": "single" } },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 19 }
    },
    {
      "id": 10,
      "type": "row",
      "title": "LTM & Simulation",
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 27 }
    },
    {
      "id": 11,
      "type": "timeseries",
      "title": "⑦ Latence LTM ChromaDB (p50 / p95)",
      "description": "Durée aquery_user_memories. Si p95 > 1s avec N agents → ChromaDB est le goulot.",
      "datasource": { "type": "prometheus", "uid": "ffj2fwnh387pce" },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.50, sum(rate(ltm_query_duration_seconds_bucket[5m])) by (le))",
          "legendFormat": "p50"
        },
        {
          "refId": "B",
          "expr": "histogram_quantile(0.95, sum(rate(ltm_query_duration_seconds_bucket[5m])) by (le))",
          "legendFormat": "p95"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 0.5 },
              { "color": "red", "value": 1 }
            ]
          }
        },
        "overrides": []
      },
      "options": { "tooltip": { "mode": "multi" } },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 28 }
    },
    {
      "id": 12,
      "type": "timeseries",
      "title": "⑧ Ratio accélération simulation (sim_time / real_time)",
      "description": "Ratio temps simulé / temps réel entre deux /sync. Décroissant au fil du temps → simulation qui ralentit.",
      "datasource": { "type": "prometheus", "uid": "ffj2fwnh387pce" },
      "targets": [
        {
          "refId": "A",
          "expr": "sim_wall_clock_ratio",
          "legendFormat": "sim/real ratio"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": null },
              { "color": "yellow", "value": 10 },
              { "color": "green", "value": 30 }
            ]
          }
        },
        "overrides": []
      },
      "options": { "tooltip": { "mode": "single" } },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 28 }
    },
    {
      "id": 13,
      "type": "row",
      "title": "Workers & Retards",
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 36 }
    },
    {
      "id": 14,
      "type": "timeseries",
      "title": "⑨ Distribution retard départ agents (skips)",
      "description": "Distribution du retard (sim_time - scheduled_start_time) lors du skip d'activité. Mesure la sévérité du drift.",
      "datasource": { "type": "prometheus", "uid": "ffj2fwnh387pce" },
      "targets": [
        {
          "refId": "A",
          "expr": "rate(agent_late_departure_seconds_bucket{le=\"60\"}[5m])",
          "legendFormat": "< 1 min"
        },
        {
          "refId": "B",
          "expr": "rate(agent_late_departure_seconds_bucket{le=\"300\"}[5m]) - rate(agent_late_departure_seconds_bucket{le=\"60\"}[5m])",
          "legendFormat": "1–5 min"
        },
        {
          "refId": "C",
          "expr": "rate(agent_late_departure_seconds_bucket{le=\"1800\"}[5m]) - rate(agent_late_departure_seconds_bucket{le=\"300\"}[5m])",
          "legendFormat": "5–30 min"
        },
        {
          "refId": "D",
          "expr": "rate(agent_late_departure_seconds_bucket{le=\"7200\"}[5m]) - rate(agent_late_departure_seconds_bucket{le=\"1800\"}[5m])",
          "legendFormat": "30 min–2 h"
        },
        {
          "refId": "E",
          "expr": "rate(agent_late_departure_seconds_bucket{le=\"+Inf\"}[5m]) - rate(agent_late_departure_seconds_bucket{le=\"7200\"}[5m])",
          "legendFormat": "> 2 h"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": { "stacking": { "mode": "normal" } }
        },
        "overrides": []
      },
      "options": { "tooltip": { "mode": "multi" } },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 37 }
    },
    {
      "id": 15,
      "type": "timeseries",
      "title": "⑩ Utilisation workers Celery par provider",
      "description": "active_workers / concurrency_limit. Si = 1.0 en permanence → workers saturés, augmenter la concurrence.",
      "datasource": { "type": "prometheus", "uid": "ffj2fwnh387pce" },
      "targets": [
        {
          "refId": "A",
          "expr": "celery_worker_utilization_ratio",
          "legendFormat": "{{provider}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0,
          "max": 1,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 0.7 },
              { "color": "red", "value": 0.95 }
            ]
          }
        },
        "overrides": []
      },
      "options": { "tooltip": { "mode": "multi" } },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 37 }
    }
  ]
}
