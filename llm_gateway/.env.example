# llm_gateway — variables d'environnement lues par le gateway (API, worker, SDK).
# Copier à la racine du dépôt : `cp llm_gateway/.env.example .env` (docker-compose lit ./.env).
# Convention pydantic-settings : nom du champ en majuscules, `__` pour un dictionnaire
# (PROVIDER_KEYS__<nom>). Aucun préfixe pour l'instant — le préfixe LLM_GATEWAY_ viendra
# avec le paramétrage en couches (itération suivante du ticket 037).
# Ne jamais versionner le .env rempli : les valeurs ci-dessous sont vides ou des défauts.

# ── Clés API des fournisseurs (secrets) ─────────────────────────────────────
# Résolution : PROVIDER_KEYS__<nom d'instance dans providers.yaml>, sinon
# PROVIDER_KEYS__<adapter>. Une instance sans clé est exclue de la rotation au démarrage
# (avertissement « Fournisseur 'x' exclu : clé API manquante »).
PROVIDER_KEYS__openai=
PROVIDER_KEYS__mistral=
PROVIDER_KEYS__google=
PROVIDER_KEYS__groq=
PROVIDER_KEYS__cerebras=
# Seconde clé Google (instance `google2`, autre projet Cloud → autre seau de quota).
PROVIDER_KEYS__google2=
# Instance `google2_35` : même clé que google2, modèle 3.5 (quota par modèle). docker-compose
# la dérive de PROVIDER_KEYS__google2 ; à renseigner ici seulement hors compose.
PROVIDER_KEYS__google2_35=

# ── Redis et Celery ──────────────────────────────────────────────────────────
# Store des tâches, files de lot, rate-limiter, compteurs du worker.
REDIS_URL=redis://localhost:6379/0
# Broker et backend de résultats Celery (bases distinctes de REDIS_URL).
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# ── Micro-batching (défauts de config/settings.py, à surcharger seulement si mesuré) ──
# Fenêtre d'accumulation d'un lot qui n'atteint pas le seuil de dispatch (secondes).
#BATCH_DELAY_SECONDS=3.0
# Taille de file déclenchant un dispatch immédiat côté API.
#BATCH_TARGET_AGENTS=10
# Plafond absolu du batch_max_agents calculé par provider.
#MAX_BATCH_AGENTS=20
# Repli de batch_max_agents si aucun provider n'est configuré.
#BATCH_MAX_AGENTS=5

# ── Budget de tokens ─────────────────────────────────────────────────────────
# tokens_in max supposés par agent (dimensionne batch_max_agents et la réservation TPM).
#ASSUMED_PROMPT_TOKENS=2200
# tokens_out estimés par agent.
#ASSUMED_OUTPUT_TOKENS=800
# tokens ≈ caractères / ratio, pour estimer le prompt rendu (mesuré : p50 = 3,24).
#TOKEN_CHARS_RATIO=3.0
# Budget de sortie minimal acceptable par requête.
#MIN_OUTPUT_TOKENS=512
# Plafond du max_tokens envoyé au provider (16 384 = limite gpt-4o-mini).
#MAX_OUTPUT_TOKENS=16384

# ── Retry et bascule ─────────────────────────────────────────────────────────
# Nombre max de self.retry() Celery pour un lot (5xx, 429, 400 max_tokens).
#MAX_RETRIES=50
# Base du backoff exponentiel : min(base × 2^tentative, 30 s).
#BACKOFF_BASE_SECONDS=1.0
# Cooldown du provider fautif quand le lot bascule vers un autre modèle.
#PROVIDER_SWITCH_COOLDOWN_SECONDS=30
# Déclaré dans Settings, non lu par le code aujourd'hui.
#CIRCUIT_BREAKER_THRESHOLD=0.95

# ── Journaux (telemetry/logger.py) ───────────────────────────────────────────
# Niveau du handler loguru posé par configure_logging() (défaut INFO).
LOG_LEVEL=INFO
# Si défini, ajoute un sink fichier APP_WORKDIR/<SERVICE_NAME>.log (rotation 10 MB, 7 jours).
# docker-compose : api, worker.
#SERVICE_NAME=api
# Dossier des journaux JSONL : llm_exchanges.jsonl (prompts + réponses), llm_errors.jsonl.
# Défaut : répertoire courant. docker-compose : /app/experiments/current.
#APP_WORKDIR=.
# Chemin complet du journal des échanges, prime sur APP_WORKDIR/llm_exchanges.jsonl.
#LLM_EXCHANGES_FILE=

# ── Tests (jamais lus par le service) ────────────────────────────────────────
# Redis réel pour les tests de contrat (sinon mémoire + fakeredis seulement).
#LLM_GATEWAY_TEST_REDIS_URL=redis://localhost:6379/15
# Gateway en marche pour les tests e2e (mobility_llm/tests/e2e) ; absent → sautés.
#LLM_GATEWAY_E2E_URL=http://localhost:8000
