# llm_gateway — variables d'environnement lues par le gateway (API, worker, CLI).
# Copier à la racine du dépôt : `cp llm_gateway/.env.example .env` (docker-compose lit ./.env).
#
# Convention (ticket 037, itération 2) : préfixe LLM_GATEWAY_, `__` sépare les niveaux
# (LLM_GATEWAY_BATCHING__DELAY_SECONDS = batching.delay_seconds). Les anciens noms sans préfixe
# (REDIS_URL, CELERY_BROKER_URL, APP_WORKDIR, SERVICE_NAME, LOG_LEVEL, LLM_EXCHANGES_FILE) sont
# encore lus une version, avec un avertissement au démarrage.
# Référence complète : docs/reference/reglages.md. Ne jamais versionner le .env rempli.

# ── Clés d'API des fournisseurs (secrets) ────────────────────────────────────
# Nom canonique : PROVIDER_KEYS__<instance ou adapter du fichier des fournisseurs>.
# LLM_GATEWAY_PROVIDER_KEYS__<nom> est accepté aussi. Une instance sans clé est exclue de la
# rotation au démarrage (« Fournisseur 'x' exclu : clé API manquante »).
PROVIDER_KEYS__openai=
PROVIDER_KEYS__mistral=
PROVIDER_KEYS__google=
PROVIDER_KEYS__groq=
PROVIDER_KEYS__cerebras=
# Seconde clé Google (instance `google2`, autre projet Cloud → autre seau de quota) ; le compose
# dérive google2_35 de google2.
PROVIDER_KEYS__google2=

# ── Fichier des fournisseurs (configuration de déploiement, hors du paquet) ──
# Sans ce chemin, le gateway charge l'exemple livré (providers.example.yaml) avec un avertissement.
LLM_GATEWAY_PROVIDERS_FILE=config/llm_gateway/providers.yaml

# ── Couches facultatives ─────────────────────────────────────────────────────
# Fichier YAML de réglages (prime sur le profil, cède devant l'environnement).
#LLM_GATEWAY_CONFIG=/etc/llm-gateway/config.yaml
# Profil livré : free-tier (défauts mesurés) ou paid.
#LLM_GATEWAY_PROFILE=free-tier

# ── Redis et exécution ───────────────────────────────────────────────────────
LLM_GATEWAY_REDIS__URL=redis://localhost:6379/0
LLM_GATEWAY_EXECUTOR__CELERY_BROKER_URL=redis://localhost:6379/1
LLM_GATEWAY_EXECUTOR__CELERY_RESULT_BACKEND=redis://localhost:6379/2

# ── Limites apprises (max_output_tokens révélé par un HTTP 400) ──────────────
# redis (partagé entre API et workers), file (JSON, sans Redis) ou none.
#LLM_GATEWAY_LEARNED_LIMITS=redis
#LLM_GATEWAY_LEARNED_LIMITS_FILE=./learned_limits.json

# ── Inférence (défauts globaux ; surcharge par fournisseur puis par requête) ──
#LLM_GATEWAY_INFERENCE__TEMPERATURE=0.7
#LLM_GATEWAY_INFERENCE__TOP_P=
#LLM_GATEWAY_INFERENCE__MAX_TOKENS=4096

# ── Micro-batching (défauts mesurés en juillet 2026, à surcharger seulement si mesuré) ──
#LLM_GATEWAY_BATCHING__DELAY_SECONDS=3.0
#LLM_GATEWAY_BATCHING__TARGET_AGENTS=10
#LLM_GATEWAY_BATCHING__MAX_BATCH_AGENTS=20
#LLM_GATEWAY_BATCHING__MAX_AGENTS=5
#LLM_GATEWAY_BATCHING__ASSUMED_PROMPT_TOKENS=2200
#LLM_GATEWAY_BATCHING__ASSUMED_OUTPUT_TOKENS=800
#LLM_GATEWAY_BATCHING__TOKEN_CHARS_RATIO=3.0
#LLM_GATEWAY_BATCHING__MIN_OUTPUT_TOKENS=512
#LLM_GATEWAY_BATCHING__MAX_OUTPUT_TOKENS=16384

# ── Réessais et bascule ──────────────────────────────────────────────────────
#LLM_GATEWAY_RESILIENCE__MAX_RETRIES=50
#LLM_GATEWAY_RESILIENCE__BACKOFF_BASE_SECONDS=1.0
#LLM_GATEWAY_RESILIENCE__PROVIDER_SWITCH_COOLDOWN_SECONDS=30
#LLM_GATEWAY_RESILIENCE__DISABLE_AFTER_CONSECUTIVE_ERRORS=30

# ── API ──────────────────────────────────────────────────────────────────────
# Liste JSON des origines CORS ; vide = aucun middleware CORS.
#LLM_GATEWAY_API__CORS_ORIGINS=["*"]
#LLM_GATEWAY_API__MAX_REQUEST_BYTES=2000000

# ── Télémétrie ───────────────────────────────────────────────────────────────
#LLM_GATEWAY_TELEMETRY__LOG_LEVEL=INFO
#LLM_GATEWAY_TELEMETRY__LOG_FORMAT=text
# Nom du service : ajoute un fichier <workdir>/<service>.log (les conteneurs : api, worker).
#LLM_GATEWAY_TELEMETRY__SERVICE_NAME=
# Dossier du run : journal des échanges, erreurs, sink service.
#LLM_GATEWAY_TELEMETRY__WORKDIR=.
# Journal des échanges (prompts et réponses complets : données personnelles potentielles) ;
# défaut <workdir>/llm_exchanges.jsonl.
#LLM_GATEWAY_TELEMETRY__EXCHANGES_FILE=
