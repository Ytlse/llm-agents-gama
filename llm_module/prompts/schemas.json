            "summary": { "type": "string", "description": "L'histoire générée à la première personne" }
          },
          "required": ["agent_id", "summary"],
          "additionalProperties": false
        }
      }
    },
    "required": ["agents"],
    "additionalProperties": false
  },
  "stm_reflection": {
    "type": "object",
    "properties": {
      "agents": {
        "type": "array",
        "items": {
          "type": "object",
          "properties": {
            "agent_id": { "type": "string" },
            "reflection": { "type": "string", "description": "Réflexion narrative sur la journée, 200 mots max" },
