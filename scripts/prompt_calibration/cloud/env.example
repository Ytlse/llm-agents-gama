# Copier ce fichier en ~/calib.env sur la VM et remplir la clé.
# Puis : chmod 600 ~/calib.env
#
# Clé de l'API Gemini (obtenue sur https://aistudio.google.com/apikey — gratuit).
# Le nom de la variable est IMPOSÉ par le code (ne pas le changer) :
#   PROVIDER_KEYS__<nom_du_provider>, ici le provider est google_gemini31.
PROVIDER_KEYS__google_gemini31=colle_ta_cle_ici
