# ==============================================================================
# .gitignore — llm-agents-gama
# ==============================================================================
# Doctrine générale :
#  1. Code, tests, spécifications, templates et configurations -> dans Git.
#  2. Données lourdes, réseaux GTFS, sauvegardes et runs -> gérés par DVC (DagsHub).
#  3. Données confidentielles / sous convention (lil-1750, ProGEDO) -> en local uniquement.
#  4. Caches, logs temporaires, scories de calcul -> exclus et purgés.
# ==============================================================================

# ==============================================================================
# 1. Système, OS et Éditeurs
# ==============================================================================
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
# Fichiers verrous temporaires créés par Microsoft Office (Word, PowerPoint)
~$*

# ==============================================================================
# 2. Environnements virtuels, Dépendances & Métadonnées de build
# ==============================================================================
.venv/
venv/
env/
ENV/
*.egg-info/
build/
dist/
# Dépendances Node (générateurs de planches de présentation)
node_modules/
package-lock.json
package.json

# ==============================================================================
# 3. Secrets, Identifiants & Configurations locales
# ==============================================================================
.env
.env.*
!.env.example
GAMA/CityTransport/config/sim_params.yaml
# Configuration Claude Code propre à la machine locale (le reste de .claude/ reste versionné)
.claude/settings.local.json
.claude/worktrees/

# ==============================================================================
# 4. Logs, Caches d'outillage & Artefacts de test
# ==============================================================================
*.pyc
*.pyo
__pycache__/
*.log
# Journaux d'échanges LLM volumineux
prompt_dialogue.log
services/llm-agents/prompt_dialogue.log

# Caches linters, typage et tests
.ruff_cache/
.mypy_cache/
.pytest_cache/
.hypothesis/
.import_linter_cache/
packages/llm_gateway/site/

# Rapports de couverture de tests
.coverage
coverage.xml
htmlcov/

# Caches applicatifs internes
cache/*
llm_cache/
services/llm-agents/cache/*
services/llm-agents/data/osmnx_cache/*
services/llm-agents/data/otp_cache/*
scripts/general/cache/*
data/cache/*

# ==============================================================================
# 5. Données de recherche DVC / DagsHub & Populations
# ==============================================================================
# Les fichiers pointeurs (*.dvc) sont versionnés dans Git.
# Les dossiers de données réelles ci-dessous restent sur le stockage DVC distant.

# Réseaux de transports, feeds annuels et graphes routiers
data/gtfs_year/*
scripts/data/gtfs_year/cache/*
scripts/data/population/Temp/*
otp-toulouse/toulouse/*
otp-toulouse/source/*
scripts/data/gtfs/*
# Exceptions explicitement documentées (ticket 031) :
!otp-toulouse/toulouse/README_Toulouse.osm.pbf.md
!scripts/data/gtfs/transit_service_hull.py
!scripts/data/gtfs/otp_link_check.py

# Sauvegardes d'anciennes populations (seule la v6 officielle et les .dvc restent dans Git)
data/population/sauvegardes/

# Expériences et campagnes (seules les définitions .yaml sont dans Git, les traces sont sur DVC)
data/jeux/
data/experiences/
!data/experiences/
!data/experiences/*/
!data/experiences/*/experience.yaml
data/experiences/.masques.json
services/llm-agents/data/experiences/

# Expériences mémoire (mêmes règles : définitions .yaml seules versionnées)
data/experiences_memoire/
!data/experiences_memoire/
!data/experiences_memoire/*/
!data/experiences_memoire/*/experience_memoire.yaml
data/experiences_memoire/*

# Campagnes de rejeu (seuls les .yaml de définition sont dans Git, etat.json est ignoré)
campagnes/*/etat.json
.config.yaml.applique

# ==============================================================================
# 6. Données restreintes sous convention (ProGEDO / EMC² / INSEE / lil-1750)
# ==============================================================================
# Données soumises à la convention lil-1750 (accès restreint, non redistribuables) :
data/insee/*
data/PROGEDO 2023/*
data/population/*
data/cache/eqasim/*
packages/mobility_core/src/mobility_core/data/zf_zones.gpkg
packages/mobility_core/src/mobility_core/data/zf_zones.meta.json
packages/mobility_core/src/mobility_core/data/zf_housing_type.json
packages/mobility_core/src/mobility_core/data/zf_couronne.json

# Données dérivées ProGEDO Logit (le code est versionné, les sorties régénérables non)
scripts/progedo_logit/*.csv
scripts/progedo_logit/*.json
scripts/progedo_logit/*.parquet
scripts/progedo_logit/*.npz
!scripts/progedo_logit/feature_spec.json

# ==============================================================================
# 7. Traces de simulation, Runs & Monitoring local
# ==============================================================================
exports/
results/
samples/
experiments*/
reports/*
services/GAMA/CityTransport/results
services/GAMA/CityTransport/results/
services/GAMA/CityTransport/results_legacy/
scripts/models_influence/results*
scripts/models_influence/calibration_results/*
scripts/synthesis/data/*
scripts/analysis/*.png
scripts/general/*.csv
docs/capture/*.png
docs/synthesis/*
docs/traces/*
tests/token_usage/
data/JOURNAL_archivage_ticket_045_2026-09-11.json

# Données de métrologie et bases de métriques
grafana_data/
prometheus_data/

# Archive froide de l'état français hors Git (ticket 074)
archive/

# ==============================================================================
# 8. Rédaction du papier, Sources & Artefacts de travail
# ==============================================================================
# Supports de présentation volumineux (PPTX / PDF de travail)
docs/slides/*.pptx
docs/slides/*.pdf
docs/slides/README.md

# Recueils de PDF lourds (éditeurs / actualités gérés sur DagsHub)
docs/paper/sources/etat_de_lart/*.pdf
docs/paper/sources/etat_de_lart/.DS_Store
docs/paper/sources/actualites/articles_html/*.pdf

# Artefacts de travail d'écriture temporaires
docs/paper/article-court/illustrations_candidates.html
docs/paper/article-court/traductions/*
docs/paper/archive/*.diff
docs/paper/mémoire/*
docs/paper/memoire
*.faux_terminee_*

# ==============================================================================
# 9. Brouillons & Dossiers temporaires de travail
# ==============================================================================
Divers/*
scratch/
609_FR.md

# ==============================================================================
# 10. Modules externes & Spécifications internes
# ==============================================================================
services/eqasim-toulouse/
services/otp-toulouse/source/ter_occitanie/
services/otp-toulouse/tools/filter_ter_gtfs.py

specs/dashboard-pilotage-activites-tickets.md
specs/hygiene-prompts-et-plateforme-experiences.md
specs/nommage-canonique-experiences.md
specs/tableau-experiences-colonnes-et-filtres.md
specs/ticket_027/questions.md
specs/ticket_027/sonde-motif-escort.md
specs/ticket_043/klr-troisieme-famille.md
specs/ticket_043/questions.md
specs/ticket_044/questions.md
specs/ticket_044/temoin_random_forest.md
specs/ticket_045/questions.md
specs/ticket_045/substrat-unique-v5.md
