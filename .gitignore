# ============================================================
# Système / éditeurs
# ============================================================
.DS_Store
# Verrous laissés par Word/PowerPoint quand un document est ouvert.
~$*

# ============================================================
# Environnements virtuels Python
# ============================================================
.venv/
venv/
env/

# ============================================================
# Secrets et configuration locale
# ============================================================
.env
GAMA/CityTransport/config/sim_params.yaml

# Configuration Claude Code propre à la machine (non partagée).
# Le reste de .claude/ (CLAUDE.md, settings.json, agents/, skills/) est
# du contenu versionné : ne pas l'ignorer en bloc, sinon tout nouveau
# fichier ajouté sans `git add -f` disparaît silencieusement.
.claude/settings.local.json

# ============================================================
# Logs et caches Python
# ============================================================
*.pyc
*.log
__pycache__/

# ============================================================
# Dossiers de résultats, d'export et d'expérimentations
# ============================================================
exports/
results/
samples/
experiments*/
GAMA/CityTransport/results
GAMA/CityTransport/results_legacy/*
scripts/models_influence/results*
scripts/analysis/*.png

# Sorties générées de la synthèse (docs/synthesis/index.html, data.json,
# archive/*) : produites par scripts/synthesis/build.py, ne pas versionner.
docs/synthesis/*
scripts/synthesis/data/*
scripts/models_influence/calibration_results/*

# Captures d'écran ponctuelles (monitoring, debug) déposées dans docs/capture/
docs/capture/*.png

# Supports de présentation déposés dans docs/slides/ : 46 Mo de PPTX et de PDF
# exportés à chaque itération, sans intérêt pour le code et définitifs une fois
# dans l'historique (le plus gros fichier versionné du dépôt fait 6,4 Mo).
# Le README du dossier, lui, reste versionné : c'est lui qui porte l'historique
# fonctionnel des versions. La règle *.pptx couvre aussi les verrous « ~$… »
# laissés par PowerPoint.
docs/slides/*.pptx
docs/slides/*.pdf

# ============================================================
# Dossiers de données de monitoring (Grafana / Prometheus)
# ============================================================
grafana_data/
prometheus_data/

# ============================================================
# Caches applicatifs
# ============================================================
cache/*
llm_cache/
llm-agents/cache/*
llm-agents/data/osmnx_cache/*
llm-agents/data/otp_cache/*
scripts/general/cache/*
data/cache/*

# Build artefact non stable (régénéré à chaque `pip install -e`) ; le reste
# du répertoire egg-info reste versionné.
llm_module/llm_gateway.egg-info/SOURCES.txt

# ============================================================
# Données OTP / GTFS / réseau temporaires
# ============================================================
otp-toulouse/toulouse/*
otp-toulouse/source/*
scripts/data/gtfs/*
# Ces deux dossiers portent des DONNÉES (pbf, graph.obj, feeds, notebooks de fouille)
# qu'on ne versionne pas — mais la provenance d'un extrait et les recettes que la
# documentation cite doivent, elles, se rejouer. Exceptions explicites (ticket 031, T1/T3/T4) :
# `Toulouse.osm.pbf.dvc` et son README disent d'où vient l'extrait OSM servi à OTP ;
# `transit_service_hull.py` recalcule `geography.TOULOUSE_TRANSIT_SERVICE_WKT` ;
# `otp_link_check.py` compte les « Couldn't link » d'une population.
!otp-toulouse/toulouse/README_Toulouse.osm.pbf.md
!scripts/data/gtfs/transit_service_hull.py
!scripts/data/gtfs/otp_link_check.py
# Feeds annuels reconstruits par `make gtfs-year` : 280 Mo décompressés,
# entièrement régénérables depuis les exports archivés. Le code du pipeline
# (scripts/data/gtfs_year/) et la trace de build restent versionnés, et
# l'instantané du calendrier scolaire aussi — c'est lui qui rend le build
# rejouable à l'identique hors ligne.
data/gtfs_year/*
scripts/data/gtfs_year/cache/*
scripts/data/population/Temp/*

# ============================================================
# Données restreintes ProGEDO / EMC² / INSEE
# ============================================================
# Couche de zones fines dérivée de l'enquête EMC² (ProGEDO / lil-1750, accès
# restreint). Même statut que sa source, qui n'est pas versionnée : on la
# régénère avec `make zones` plutôt que de la committer.
llm_module/data/zf_zones.gpkg
llm_module/data/zf_zones.meta.json

# Loi du type de logement par zone fine, dérivée de la même enquête (action A2).
# Même statut, même raison : `make housing-type` la régénère.
llm_module/data/zf_housing_type.json

data/insee/*
data/PROGEDO 2023/*
data/population/*
data/cache/eqasim/*

# Jeux de données ProGEDO Logit générés (exploration, fits, exports) : le
# code (*.py, *.ipynb) reste versionné, les données dérivées non.
scripts/progedo_logit/*.csv
scripts/progedo_logit/*.json
scripts/progedo_logit/*.parquet
!scripts/progedo_logit/feature_spec.json

# ============================================================
# Fichiers de données et de debug spécifiques
# ============================================================
scripts/general/*.csv
Divers/*

# ============================================================
# Dépôts git externes / séparés (gérés indépendamment, ne pas versionner
# leur contenu dans ce dépôt)
# ============================================================
# EQUASIM Toulouse
eqasim-toulouse/
# Calibration de prompt (github.com/Ytlse/prompt_calibration)
prompt_calibration/
# Assistant personnel — dépôt git autonome imbriqué
docs/slides/README.md
# Les traces d'expériences se versionnent PAR DATE ET HEURE sur disque (docs/traces/<AAAA-MM-JJ_HH-MM>_…),
# pas dans git — décision du 2026-09-02. Ce qui se versionne dans git est l'artefact scellé
# (data/population/population_1000_AAMAS/) et sa documentation.
docs/traces/*
